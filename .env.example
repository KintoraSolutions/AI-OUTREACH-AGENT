# ---- Core (required to run) ----
DATABASE_URL="postgresql://user:password@localhost:5432/outreach?schema=public"
# Prisma migrations use a direct (unpooled) connection. In local dev this can equal DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/outreach?schema=public"

# Auth.js (NextAuth v5). Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
# Base URL of the app. Optional in dev; required in production.
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth (sign-in + incremental Gmail/Calendar authorization) ----
# One OAuth client powers both sign-in and the Gmail/Calendar integration. In the
# Google Cloud console (APIs & Services -> Credentials -> OAuth client, type "Web
# application"), register these Authorized redirect URIs:
#   - Sign-in:      {NEXTAUTH_URL}/api/auth/callback/google
#   - Integrations: {NEXTAUTH_URL}/api/integrations/google/callback
# e.g. http://localhost:3000/api/integrations/google/callback in development.
# Enable the Gmail API and Google Calendar API. Requested scopes are
# least-privilege: gmail.compose (create drafts, never send) and calendar.events.
# Gmail/Calendar are "sensitive" scopes and need Google verification for
# production; add your address as a Test user on the OAuth consent screen during
# development.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Development-only convenience sign-in ----
# When NODE_ENV=development AND this is "true", a "Sign in as test user" option is shown.
# Never enabled in production. Requires the seed to have been run.
AUTH_DEV_LOGIN="false"
# Comma-separated sign-in allowlist. Set this in production.
# Unset in production means "existing users only" - nobody new can register.
AUTH_ALLOWED_EMAILS=""

# ---- Providers configured in later phases (features report as unavailable until set) ----
# AI (Phase 4). AI_MODEL is fully configurable (never a hardcoded, unchangeable
# model). Without ANTHROPIC_API_KEY, drafting reports as unavailable and is never
# faked. The optional tuning vars below show their defaults.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="60000"
AI_MAX_RETRIES="2"
AI_MAX_OUTPUT_TOKENS="1024"
# Delay (ms) between clinics in a bulk drafting job, for AI rate limiting.
DRAFT_BULK_DELAY_MS="750"
# Discovery + performance (Phase 3)
GOOGLE_PLACES_API_KEY=""
PAGESPEED_API_KEY=""
# Headless browser (deferred; default null)
BROWSER_PROVIDER="null"
BROWSERLESS_API_KEY=""
CLOUDFLARE_BROWSER_TOKEN=""
# ---- Background jobs: Inngest (Phase 3) ----
# Inngest runs durable, retried research jobs. It is REQUIRED in production; the
# in-process runner is never used there (serverless cannot reliably finish long
# crawls). In local development, leave these blank and use the Inngest Dev Server
# (npx inngest-cli@latest dev) — the in-process runner is used automatically when
# these are unset. Get keys from the Inngest dashboard for production.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Optional local override: force a runner regardless of the above. Values:
# "inline" | "inngest". Ignored in production (Inngest is always required there).
# Leave unset. Local-only override; ignored in production.
# JOB_RUNNER="inline"
# Storage for screenshots (deferred)
BLOB_READ_WRITE_TOKEN=""
# Email verification (optional; default none)
EMAIL_VERIFIER="none"
EMAIL_VERIFIER_API_KEY=""
# Encryption key for stored OAuth tokens (Gmail/Calendar), AES-256-GCM at rest.
# Must be base64 encoding EXACTLY 32 bytes. Required before connecting Google.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Public origin of the deployment, used for social/OG metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
